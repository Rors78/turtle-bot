# Turtle Bot — Environment Configuration
# Copy this file to .env and fill in your values.
# API keys are OPTIONAL: paper/read-only mode uses Kraken's public REST API.
# Keys are only required for live order execution.

# ─────────────────────────────────────────────────────────────────────────────
# ACCOUNT
# ─────────────────────────────────────────────────────────────────────────────

# Starting account size in USD. Used for equity tracking and position sizing.
# Note: on a $130 account, Turtle formula sizes by risk (2% = $2.60/unit).
# Most Kraken pairs have a $10–$25 minimum order — positions may be skipped
# until the account grows or RISK_PER_TRADE is increased.
ACCOUNT_SIZE=130

# ─────────────────────────────────────────────────────────────────────────────
# EXCHANGE CREDENTIALS
# ─────────────────────────────────────────────────────────────────────────────

# Kraken API key and secret. Leave blank for paper trading (public API only).
# Generate at: https://www.kraken.com/u/security/api
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# TRADING MODE
# ─────────────────────────────────────────────────────────────────────────────

# True = simulate trades (no real orders). False = live execution on Kraken.
# Always start with True and verify behaviour before switching to False.
PAPER_TRADING=True

# Simulated slippage applied to fills in paper trading mode (0.001 = 0.1%).
PAPER_SLIPPAGE=0.001

# ─────────────────────────────────────────────────────────────────────────────
# TURTLE SYSTEM PARAMETERS
# ─────────────────────────────────────────────────────────────────────────────

# Enable/disable each system independently.
SYSTEM_1_ENABLED=True
SYSTEM_2_ENABLED=True

# Fraction of capital allocated to System 1 (remainder goes to System 2).
# 0.6 = 60% to S1 (20-day breakout), 40% to S2 (55-day breakout).
SYSTEM_SPLIT=0.6

# System 1 breakout and exit periods (days).
SYSTEM_1_ENTRY=20
SYSTEM_1_EXIT=10

# System 2 breakout and exit periods (days).
SYSTEM_2_ENTRY=55
SYSTEM_2_EXIT=20

# ATR look-back period for N calculation.
ATR_PERIOD=20

# ─────────────────────────────────────────────────────────────────────────────
# POSITION SIZING AND STOP RULES (classic Turtle rules)
# ─────────────────────────────────────────────────────────────────────────────

# Fraction of account equity risked per unit (0.02 = 2%).
RISK_PER_TRADE=0.02

# Maximum pyramid units per position (Turtle standard: 4).
MAX_UNITS_PER_POSITION=4

# Price increment (in N multiples) required to add the next pyramid unit (standard: 0.5).
PYRAMID_INCREMENT=0.5

# Stop-loss distance in N multiples below latest entry (standard: 2.0).
STOP_DISTANCE=2.0

# ─────────────────────────────────────────────────────────────────────────────
# PORTFOLIO LIMITS
# ─────────────────────────────────────────────────────────────────────────────

# Minimum and maximum number of concurrent open positions.
MIN_COINS=2
MAX_COINS=10

# Minimum and maximum single-position allocation as fraction of balance.
MIN_ALLOCATION=0.10
MAX_ALLOCATION=0.50

# Maximum positions allowed per sector (correlation filter).
# Sectors are defined in config.py (L1, DEFI, INFRA, MEME, etc.).
MAX_CORRELATED_COINS=2

# ─────────────────────────────────────────────────────────────────────────────
# RISK LIMITS
# ─────────────────────────────────────────────────────────────────────────────

# Maximum total portfolio risk across all open positions (0.20 = 20%).
MAX_TOTAL_RISK=0.20

# Drawdown level that triggers emergency stop — all positions closed (0.30 = 30%).
EMERGENCY_STOP_LOSS=0.30

# Minimum account balance; bot refuses to open new positions below this.
MIN_ACCOUNT_BALANCE=100.00

# Fraction of balance kept as undeployed cash reserve (0.10 = 10%).
RESERVE_CASH_PCT=0.10

# ─────────────────────────────────────────────────────────────────────────────
# DATA SOURCES
# ─────────────────────────────────────────────────────────────────────────────

# OHLC candle timeframe for Kraken (daily recommended for Turtle).
OHLC_TIMEFRAME=1d

# Number of candles fetched per symbol per cycle.
OHLC_LIMIT=60

# True = build trading universe by scanning Kraken pairs ranked by 24h volume.
# False = use the FIXED_COINS list defined in config.py.
SCAN_TOP_COINS=True

# How many top Kraken pairs by volume to include (requires SCAN_TOP_COINS=True).
TOP_N_COINS=50

# Process symbols in batches of this size when fetching OHLC data.
BATCH_SIZE=20

# ─────────────────────────────────────────────────────────────────────────────
# OPERATIONAL SETTINGS
# ─────────────────────────────────────────────────────────────────────────────

# Seconds between bot cycles (default: 300 = 5 minutes).
CHECK_INTERVAL=300

# Path to the JSON state file (relative to project root or absolute).
STATE_FILE=bot_state.json

# Path to the structured log file.
LOG_FILE=turtle_signals.log

# Path to the JSONL order audit trail.
AUDIT_FILE=trade_audit.jsonl

# Log format for the file handler: 'json' = structured JSON Lines (default),
# any other value = plain text. Console always uses human-readable text.
LOG_FORMAT=json

# ─────────────────────────────────────────────────────────────────────────────
# WEB DASHBOARD
# ─────────────────────────────────────────────────────────────────────────────

# TCP port the Flask dashboard listens on.
DASHBOARD_PORT=5001

# ─────────────────────────────────────────────────────────────────────────────
# TRAILING STOPS (opt-in feature — disabled by default)
# ─────────────────────────────────────────────────────────────────────────────

# Enable ATR-based trailing stops. When True, the stop is ratcheted up
# as price rises; it never moves back down. Classic Turtle stops are used
# when this is False.
TRAILING_STOP_ENABLED=False

# Method to use for trailing stop calculation.
# 'atr' = trail by TRAILING_STOP_DISTANCE * initial N from the highest price seen.
TRAILING_STOP_METHOD=atr

# Trailing distance in N multiples (2.0 matches the classic Turtle stop distance).
TRAILING_STOP_DISTANCE=2.0

# ─────────────────────────────────────────────────────────────────────────────
# REGIME DETECTION (opt-in feature — disabled by default)
# ─────────────────────────────────────────────────────────────────────────────

# Enable ADX-based regime filter. When True, new entries are only taken if
# the ADX reading is at or above REGIME_MIN_ADX (trending market).
# Existing positions are always managed regardless of this setting.
REGIME_FILTER_ENABLED=False

# ADX look-back period in days.
REGIME_ADX_PERIOD=14

# Minimum ADX value required to allow a new entry (25.0 = trending market threshold).
REGIME_MIN_ADX=25.0

# ─────────────────────────────────────────────────────────────────────────────
# DISCORD NOTIFICATIONS (opt-in feature — disabled by default)
# ─────────────────────────────────────────────────────────────────────────────

# Send trade alerts to a Discord channel via webhook.
# Leave DISCORD_WEBHOOK_URL blank (or ALERT_ON_DISCORD=False) to disable.
ALERT_ON_DISCORD=False
DISCORD_WEBHOOK_URL=

# Granular alert toggles (all default True — only relevant when Discord is enabled).
ALERT_ON_ENTRY=True
ALERT_ON_EXIT=True
ALERT_ON_STOP=True
ALERT_ON_ERROR=True
